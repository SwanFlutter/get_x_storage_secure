# What `dart pub publish` must leave out. When this file exists, pub uses it in
# place of the .gitignore-derived list, so it repeats the entries that matter
# here and adds the ones only a published archive cares about.

# Build output.
build/
/coverage/
**/.cxx/
**/.gradle/
**/local.properties
**/doc/api/
.dart_tool/
.build/
.flutter-plugins-dependencies
/pubspec.lock

# Editor and machine state.
/.idea/
*.iml

# An earlier round's own archive, and the copy of the package unpacked beside it.
/get_x_storage_secure.zip
/get_x_storage_secure/
